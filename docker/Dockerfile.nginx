FROM nginx:stable

# Install dependencies for health checks and wait script
RUN apt-get update && apt-get install -y curl netcat-openbsd && rm -rf /var/lib/apt/lists/*

# Copy both nginx configurations
COPY ./nginx.http.conf /etc/nginx/nginx.conf
COPY ./nginx.prod.conf /etc/nginx/nginx.prod.conf

# Copy and setup wait script
COPY ./wait-for-it.sh /wait-for-it.sh
RUN chmod +x /wait-for-it.sh

# Include certbot webroot path
RUN mkdir -p /var/www/certbot

# Expose ports
EXPOSE 80 443

# Use wait script to ensure services are ready before starting nginx
CMD ["/wait-for-it.sh", "web:8000", "--", "/wait-for-it.sh", "rag:8001", "--", "nginx", "-g", "daemon off;"]